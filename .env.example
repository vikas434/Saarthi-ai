# Model that plays the customer and the coach. Without a key the app runs in offline demo mode.
LLM_PROVIDER=anthropic            # anthropic | openai_compatible
LLM_MODEL=claude-haiku-5-5
# Thinking effort for replies (low | medium | high). The scorecard always uses medium.
LLM_EFFORT=low
ANTHROPIC_API_KEY=
# For a company gateway: LLM_PROVIDER=openai_compatible plus these
LLM_API_KEY=
LLM_BASE_URL=
# Where sessions are stored. Set DATABASE_URL for Postgres (deployment); leave it empty to use
# the local SQLite file at SAARTHI_DB. The schema is migrated on start (python -m app.db upgrade).
DATABASE_URL=
SAARTHI_DB=data/saarthi.db
# Sign-in (Clerk). Copy the keys from the Clerk dashboard (API keys page).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated origins allowed to present Clerk tokens, e.g. https://saarthi.example.com
CLERK_AUTHORIZED_PARTIES=
# Who may use Saarthi. TEACHER_EMAIL is the admin; STUDENT_EMAILS (comma-separated) are agents.
# Anyone else sees "Your request is received. We will review and approve."
TEACHER_EMAIL=
STUDENT_EMAILS=
# Local only: sign in by typing an allow-listed email instead of Clerk. Refused on a hosted server.
AUTH_DEV_BYPASS=
# Limits (demo defaults). Model prices are in config/pricing.json.
DAILY_SPEND_CAP_USD=0.50
MAX_CALLS_PER_USER_PER_DAY=20
RATE_LIMIT_PER_MINUTE=60
